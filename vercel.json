{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/race/?$", "dest": "/race.html" },
    { "src": "/leaderboard/?$", "dest": "/leaderboard.html" },
    { "src": "/games/?$", "dest": "/games/index.html" },
    { "src": "/track-id/?$", "dest": "/track-id/index.html" },
    { "src": "/dragon-tunes/?$", "dest": "/track-id/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}