# Render backend environment only. Never commit real secrets.
SUPABASE_URL=
SUPABASE_KEY=

# Spotify Web API application credentials (server-to-server Client Credentials flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Soundcharts API credentials (OAuth client credentials)
SOUNDCHARTS_CLIENT_ID=
SOUNDCHARTS_CLIENT_SECRET=
# Optional only when your Soundcharts account uses a specific team
SOUNDCHARTS_TEAM_ID=
